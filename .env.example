# Environment Variables - LOCAL DEVELOPMENT
# Copy this file to .env.local for local development
# NEVER commit .env.local to GitHub

# Admin Credentials (for local testing only)
# Leave empty to use config-credentials.json
ADMIN_USER=
ADMIN_PASS=

# Firebase Configuration
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# EmailJS Configuration
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Application Settings
NODE_ENV=development
DEBUG=false
LOG_LEVEL=info

# API Endpoints
API_BASE_URL=http://localhost:8000
FIREBASE_EMULATOR=false

# PDF Generation
PDF_LOGO_URL=https://your-domain.com/logo.png
PDF_COMPANY_NAME=Devices F2
PDF_COMPANY_EMAIL=contact@example.com

# Analytics
GTAG_ID=
SENTRY_DSN=
