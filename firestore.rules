rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /testimonios/{id} {
      allow read: if true;
      allow create: if true;
      // Permitir updates anónimos solo cuando modifican exclusivamente los campos
      // `likes` y `likedBy`. Corregimos `request.data` -> `request.resource.data`.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'likedBy']) || (request.auth != null && request.auth.token.admin == true);
      allow delete: if request.auth != null && request.auth.token.admin == true;
    }
    match /courses/{courseId} {
      allow read: if request.auth != null;
      match /modules/{moduleId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.token.admin == true;
      }
    }
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}